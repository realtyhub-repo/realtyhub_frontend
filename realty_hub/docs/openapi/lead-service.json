{
  "openapi": "3.1.0",
  "info": {
    "title": "RealtyHub - Lead Service",
    "description": "Gestión de leads: creación con agendamiento de visita y asignación automática de agente, y seguimiento del embudo.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8084",
      "description": "Generated server url"
    }
  ],
  "security": [
    {
      "X-User-Id": [],
      "X-User-Role": []
    }
  ],
  "tags": [
    {
      "name": "Leads",
      "description": "Leads de clientes interesados en una propiedad"
    }
  ],
  "paths": {
    "/leads/{id}/estado": {
      "put": {
        "tags": [
          "Leads"
        ],
        "summary": "Cambiar el estado de un lead",
        "description": "Agente dueño del lead o administrador. Los estados terminales (CERRADO, DESCARTADO) no se pueden modificar. Al pasar a OFERTA_ACEPTADA se publica el evento lead.oferta_aceptada para que Contratos genere el borrador.",
        "operationId": "cambiarEstado",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CambiarEstadoLeadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Estado actualizado"
          },
          "403": {
            "description": "Sin permiso sobre el lead"
          },
          "404": {
            "description": "Lead no encontrado"
          },
          "409": {
            "description": "El lead ya está en un estado terminal"
          }
        }
      }
    },
    "/leads": {
      "post": {
        "tags": [
          "Leads"
        ],
        "summary": "Crear lead y agendar visita",
        "description": "Solo CLIENTE. Valida la propiedad, busca agentes cercanos, descarta los ocupados en esa fecha/hora, los ordena por zona, carga y conversión y reserva la visita con el primero libre.",
        "operationId": "crear",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearLeadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Lead creado con visita agendada",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LeadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Fecha inválida o fuera de horario / solicitud inválida",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LeadResponse"
                }
              }
            }
          },
          "404": {
            "description": "Propiedad no encontrada",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LeadResponse"
                }
              }
            }
          },
          "409": {
            "description": "Lead duplicado, propiedad ocupada o sin agentes disponibles",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LeadResponse"
                }
              }
            }
          },
          "503": {
            "description": "Servicio de visitas no disponible",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LeadResponse"
                }
              }
            }
          }
        }
      }
    },
    "/leads/{id}/visitas": {
      "post": {
        "tags": [
          "Leads"
        ],
        "summary": "Agendar otra visita sobre un lead existente",
        "description": "Solo el CLIENTE dueño del lead. Reutiliza el agente asignado al lead.",
        "operationId": "agendarVisita",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgendarVisitaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Visita agendada",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LeadResponse"
                }
              }
            }
          },
          "403": {
            "description": "El lead no pertenece al cliente",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LeadResponse"
                }
              }
            }
          },
          "404": {
            "description": "Lead o propiedad no encontrados",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LeadResponse"
                }
              }
            }
          },
          "409": {
            "description": "Agente o propiedad ocupados, o ya existe una visita programada",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LeadResponse"
                }
              }
            }
          }
        }
      }
    },
    "/leads/{id}": {
      "get": {
        "tags": [
          "Leads"
        ],
        "summary": "Detalle de un lead",
        "description": "Agente dueño o administrador. Incluye los datos de contacto del cliente.",
        "operationId": "obtenerDetalle",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "403": {
            "description": "Sin permiso sobre el lead",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LeadDetalleResponse"
                }
              }
            }
          },
          "404": {
            "description": "Lead no encontrado",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LeadDetalleResponse"
                }
              }
            }
          }
        }
      }
    },
    "/leads/mis-leads": {
      "get": {
        "tags": [
          "Leads"
        ],
        "summary": "Listar mis leads",
        "description": "Leads asignados al agente autenticado, con filtro opcional por estado.",
        "operationId": "listarMisLeads",
        "parameters": [
          {
            "name": "estado",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "CONTACTADO",
                "VISITA_AGENDADA",
                "OFERTA_PRESENTADA",
                "NEGOCIACION",
                "CERRADO",
                "DESCARTADO"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LeadResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CambiarEstadoLeadRequest": {
        "type": "object",
        "properties": {
          "nuevoEstado": {
            "type": "string",
            "enum": [
              "CONTACTADO",
              "VISITA_AGENDADA",
              "OFERTA_PRESENTADA",
              "NEGOCIACION",
              "CERRADO",
              "DESCARTADO"
            ]
          }
        },
        "required": [
          "nuevoEstado"
        ]
      },
      "CrearLeadRequest": {
        "type": "object",
        "properties": {
          "propiedadId": {
            "type": "string",
            "format": "uuid"
          },
          "fechaHora": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "fechaHora",
          "propiedadId"
        ]
      },
      "LeadResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "propiedadId": {
            "type": "string",
            "format": "uuid"
          },
          "clienteId": {
            "type": "string",
            "format": "uuid"
          },
          "estado": {
            "type": "string",
            "enum": [
              "CONTACTADO",
              "VISITA_AGENDADA",
              "OFERTA_PRESENTADA",
              "NEGOCIACION",
              "CERRADO",
              "DESCARTADO"
            ]
          },
          "agenteId": {
            "type": "string",
            "format": "uuid"
          },
          "visitaId": {
            "type": "string",
            "format": "uuid"
          },
          "fechaHoraVisita": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AgendarVisitaRequest": {
        "type": "object",
        "properties": {
          "fechaHora": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "fechaHora"
        ]
      },
      "LeadDetalleResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "propiedadId": {
            "type": "string",
            "format": "uuid"
          },
          "estado": {
            "type": "string",
            "enum": [
              "CONTACTADO",
              "VISITA_AGENDADA",
              "OFERTA_PRESENTADA",
              "NEGOCIACION",
              "CERRADO",
              "DESCARTADO"
            ]
          },
          "clienteId": {
            "type": "string",
            "format": "uuid"
          },
          "nombreCliente": {
            "type": "string"
          },
          "telefonoCliente": {
            "type": "string"
          },
          "emailCliente": {
            "type": "string"
          },
          "agenteId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "X-User-Id": {
        "type": "apiKey",
        "description": "UUID del usuario autenticado (lo inyecta el Gateway tras validar el JWT)",
        "name": "X-User-Id",
        "in": "header"
      },
      "X-User-Role": {
        "type": "apiKey",
        "description": "ADMINISTRADOR_CENTRAL | GERENTE_OFICINA | AGENTE | CLIENTE",
        "name": "X-User-Role",
        "in": "header"
      }
    }
  }
}