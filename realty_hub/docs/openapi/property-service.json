        "operationId": "eliminarImagen",
        "parameters": [
          {
            "name": "imagenId",
            "in": "path",
            "description": "Id de la imagen",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "description": "Id del usuario autenticado (lo inyecta el API Gateway)",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
