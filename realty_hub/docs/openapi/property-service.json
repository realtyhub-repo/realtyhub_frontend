{
  "openapi": "3.1.0",
  "info": {
    "title": "RealtyHub - Servicio de Propiedades",
    "description": "Gestión de propiedades inmobiliarias y sus imágenes.\n\n**Autenticación:** el API Gateway valida al usuario y reenvía su identidad en los headers `X-User-Id` (UUID) y `X-User-Role` (rol). Los endpoints protegidos los requieren; si faltan o son inválidos se responde `401`.\n",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8083",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Imágenes de propiedades",
      "description": "Subida de imágenes a R2 mediante URLs prefirmadas, confirmación, portada y eliminación"
    },
    {
      "name": "Interno",
      "description": "Endpoints para comunicación entre microservicios; no se exponen a través del API Gateway"
    },
    {
      "name": "Propiedades",
      "description": "Creación, consulta, actualización y cambio de estado de propiedades"
    }
  ],
  "paths": {
    "/propiedades/{id}": {
      "get": {
        "tags": [
          "Propiedades"
        ],
        "summary": "Obtener detalle de una propiedad",
        "description": "Devuelve la información completa de la propiedad, incluyendo imágenes y nombre del agente. Endpoint público; si se envían los headers de usuario se usan para registrar la vista.",
        "operationId": "obtenerDetalles",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id de la propiedad",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "description": "Id del usuario autenticado (opcional)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-User-Role",
            "in": "header",
            "description": "Rol del usuario autenticado (opcional)",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Rol del usuario autenticado",
              "enum": [
                "ADMINISTRADOR_CENTRAL",
                "GERENTE_OFICINA",
                "AGENTE",
                "CLIENTE"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle de la propiedad",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PropiedadDetalleResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/PropiedadNoEncontrada"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "put": {
        "tags": [
          "Propiedades"
        ],
        "summary": "Actualizar propiedad",
        "description": "Actualización parcial: solo se modifican los campos enviados. Permitido al agente dueño de la propiedad o al ADMINISTRADOR_CENTRAL.",
        "operationId": "actualizar",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id de la propiedad",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "description": "Id del usuario autenticado (lo inyecta el API Gateway)",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-User-Role",
            "in": "header",
            "description": "Rol del usuario autenticado (lo inyecta el API Gateway)",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "ADMINISTRADOR_CENTRAL",
                "GERENTE_OFICINA",
                "AGENTE",
                "CLIENTE"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActualizarPropiedadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Propiedad actualizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PropiedadResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/PropiedadNoEncontrada"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
