                "AGENTE",
                "CLIENTE"
              ]
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Imagen eliminada"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/ImagenNoEncontrada"
          },
          "500": {
            "description": "No se pudo eliminar la imagen del almacenamiento o error inesperado",
            "content": {
