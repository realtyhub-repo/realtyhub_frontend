    "/propiedades/{id}/imagenes/upload-urls": {
      "post": {
        "tags": [
          "Imágenes de propiedades"
        ],
        "summary": "Generar URLs de subida",
        "description": "Paso 1 de la subida de imágenes. Genera una URL prefirmada por cada archivo; el cliente debe hacer `PUT` del archivo directamente a `uploadUrl` y luego confirmar las `key` con `POST /propiedades/{id}/imagenes/confirmar`. Formatos permitidos: jpg, jpeg, png, webp. Permitido al agente dueño de la propiedad o al ADMINISTRADOR_CENTRAL.",
        "operationId": "generarUls",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id de la propiedad",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "description": "Id del usuario autenticado (lo inyecta el API Gateway)",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-User-Role",
            "in": "header",
            "description": "Rol del usuario autenticado (lo inyecta el API Gateway)",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "ADMINISTRADOR_CENTRAL",
                "GERENTE_OFICINA",
                "AGENTE",
                "CLIENTE"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerarUrlsSubidaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "URLs de subida generadas, en el mismo orden que los archivos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UploadUrlResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida o uno o más archivos con formato no soportado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "Validación": {
                    "description": "Validación",
                    "value": {
                      "mensaje": "no debe estar vacío",
                      "status": 400,
                      "timestamp": "2026-01-15T10:30:00"
                    }
                  }
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                "examples": {
                  "Formato no soportado": {
                    "description": "Formato no soportado",
                    "value": {
                      "type": "about:blank",
                      "title": "Formato de imagen no soportado",
                      "status": 400,
                      "detail": "Formato no soportado en 1 imagen(es). Formatos permitidos: jpeg, jpg, png, webp",
                      "instance": "/propiedades/3fa85f64-5717-4562-b3fc-2c963f66afa6/imagenes/upload-urls",
                      "imagenesInvalidas": [
                        {
                          "indice": 1,
                          "nombre": "plano.gif"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/PropiedadNoEncontrada"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
