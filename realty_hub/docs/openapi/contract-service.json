{
  "openapi": "3.1.0",
  "info": {
    "title": "RealtyHub - Servicio de Contratos",
    "description": "Gestión del ciclo de vida de contratos inmobiliarios: consulta, edición, firma, cancelación y descarga de documentos PDF.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8086",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Contratos",
      "description": "Consulta y gestión del ciclo de vida de los contratos"
    }
  ],
  "paths": {
    "/contratos/{id}": {
      "get": {
        "tags": [
          "Contratos"
        ],
        "summary": "Obtener detalle de un contrato",
        "description": "Devuelve el contrato completo, incluido su contenido renderizado. Accesible para el cliente, el agente del contrato o un administrador central.",
        "operationId": "obtenerDetalle",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id del contrato",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "description": "Id del usuario autenticado",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-User-Role",
            "in": "header",
            "description": "Rol del usuario autenticado",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "ADMINISTRADOR_CENTRAL",
                "GERENTE_OFICINA",
                "AGENTE",
                "CLIENTE"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle del contrato",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ContratoDetalleResponse"
                }
              }
            }
          },
          "400": {
            "description": "Id con formato inválido",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Headers de autenticación faltantes o inválidos",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "El usuario no participa en el contrato",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Contrato no encontrado",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Contratos"
        ],
        "summary": "Actualizar precio acordado",
        "description": "Modifica el precio acordado y vuelve a renderizar el contenido. Solo el agente del contrato o un administrador central, y solo en estado BORRADOR.",
        "operationId": "actualizar",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id del contrato",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "description": "Id del usuario autenticado",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-User-Role",
            "in": "header",
            "description": "Rol del usuario autenticado",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "ADMINISTRADOR_CENTRAL",
                "GERENTE_OFICINA",
                "AGENTE",
                "CLIENTE"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActualizarContratoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Contrato actualizado",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ContratoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Cuerpo de la solicitud inválido",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Headers de autenticación faltantes o inválidos",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "El usuario no es el agente del contrato ni administrador",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Contrato no encontrado",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "El contrato no está en BORRADOR",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/contratos/{id}/firmar": {
      "patch": {
        "tags": [
          "Contratos"
        ],
        "summary": "Firmar contrato",
        "description": "Pasa el contrato de BORRADOR a FIRMADO, genera el PDF definitivo, lo almacena y publica el evento de contrato firmado. Requiere precio acordado.",
        "operationId": "firmar",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id del contrato",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "description": "Id del usuario autenticado",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-User-Role",
            "in": "header",
            "description": "Rol del usuario autenticado",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "ADMINISTRADOR_CENTRAL",
                "GERENTE_OFICINA",
                "AGENTE",
                "CLIENTE"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contrato firmado",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ContratoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Id con formato inválido",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Headers de autenticación faltantes o inválidos",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "El usuario no es el agente del contrato ni administrador",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Contrato no encontrado",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "El contrato no está en BORRADOR o no tiene precio acordado",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Error al generar el PDF",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Error al almacenar el documento",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/contratos/{id}/cancelar": {
      "patch": {
        "tags": [
          "Contratos"
        ],
        "summary": "Cancelar contrato",
        "description": "Pasa el contrato a CANCELADO. Si estaba FIRMADO, publica el evento de contrato cancelado.",
        "operationId": "cancelar",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id del contrato",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "description": "Id del usuario autenticado",
