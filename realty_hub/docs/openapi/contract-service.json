        "operationId": "vistaPrevia",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id del contrato",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
