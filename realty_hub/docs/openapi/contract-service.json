    "/contratos/mis-contratos": {
      "get": {
        "tags": [
          "Contratos"
        ],
        "summary": "Listar mis contratos",
        "description": "Devuelve los contratos del cliente o agente autenticado, del más reciente al más antiguo. Solo disponible para los roles CLIENTE y AGENTE.",
        "operationId": "listarMisContratos",
        "parameters": [
          {
            "name": "estado",
            "in": "query",
            "description": "Filtra por estado del contrato",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "BORRADOR",
                "FIRMADO",
                "CANCELADO"
              ]
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "description": "Id del usuario autenticado",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-User-Role",
            "in": "header",
            "description": "Rol del usuario autenticado",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "ADMINISTRADOR_CENTRAL",
                "GERENTE_OFICINA",
                "AGENTE",
                "CLIENTE"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Listado de contratos",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ContratoResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Estado con formato inválido",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Headers de autenticación faltantes o inválidos",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "El rol no tiene un listado de contratos propio",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActualizarContratoRequest": {
        "type": "object",
        "description": "Datos para actualizar un contrato en BORRADOR",
        "properties": {
          "precioAcordado": {
            "type": "number",
            "description": "Precio acordado entre las partes",
            "example": 350000000,
            "minimum": 0.01
          }
        },
        "required": [
          "precioAcordado"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Respuesta de error estándar del servicio",
        "properties": {
          "codigo": {
            "type": "string",
            "description": "Código del error",
            "example": "CONTRATO_NO_ENCONTRADO"
          },
          "mensaje": {
            "type": "string",
            "description": "Mensaje legible del error",
            "example": "Contrato no encontrado"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "Código HTTP",
            "example": 404
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora del error"
          }
        }
      },
      "ContratoResponse": {
        "type": "object",
        "description": "Resumen de un contrato",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Id del contrato"
          },
          "leadId": {
            "type": "string",
            "format": "uuid",
            "description": "Id del lead que originó el contrato"
          },
          "propiedadId": {
            "type": "string",
            "format": "uuid",
            "description": "Id de la propiedad"
          },
          "clienteId": {
            "type": "string",
            "format": "uuid",
            "description": "Id del cliente"
          },
          "agenteId": {
            "type": "string",
            "format": "uuid",
            "description": "Id del agente"
          },
          "tipo": {
            "type": "string",
            "description": "Tipo de contrato",
            "enum": [
              "ARRAS",
              "ALQUILER",
              "COMPRAVENTA"
            ]
          },
          "estado": {
            "type": "string",
            "description": "Estado actual del contrato",
            "enum": [
              "BORRADOR",
              "FIRMADO",
              "CANCELADO"
            ]
          },
          "precioAcordado": {
            "type": "number",
            "description": "Precio acordado; null mientras no se haya definido",
            "example": 350000000
          },
          "firmadoEn": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora de la firma; null si no está firmado"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora de creación"
          }
        }
      },
      "ContratoDetalleResponse": {
        "type": "object",
        "description": "Detalle completo de un contrato",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Id del contrato"
          },
          "leadId": {
            "type": "string",
            "format": "uuid",
            "description": "Id del lead que originó el contrato"
          },
          "propiedadId": {
            "type": "string",
            "format": "uuid",
            "description": "Id de la propiedad"
          },
          "clienteId": {
            "type": "string",
            "format": "uuid",
            "description": "Id del cliente"
          },
          "agenteId": {
            "type": "string",
            "format": "uuid",
            "description": "Id del agente"
          },
          "tipo": {
            "type": "string",
            "description": "Tipo de contrato",
            "enum": [
              "ARRAS",
              "ALQUILER",
              "COMPRAVENTA"
            ]
          },
          "estado": {
            "type": "string",
            "description": "Estado actual del contrato",
            "enum": [
              "BORRADOR",
              "FIRMADO",
              "CANCELADO"
            ]
          },
          "pais": {
            "type": "string",
            "description": "Código del país del contrato",
            "example": "CO"
          },
          "precioAcordado": {
            "type": "number",
            "description": "Precio acordado; null mientras no se haya definido",
            "example": 350000000
          },
          "contenido": {
            "type": "string",
