# URL base del API Gateway: todos los servicios (auth, users, oficinas, agentes) pasan por aquí
REALTYHUB_API_BASE_URL=http://localhost:8081
# Client ID de Google (el mismo con el que el backend valida los id_token)
REALTYHUB_GOOGLE_CLIENT_ID=
# Token público de Mapbox (pk.…) para los mapas de oficinas. Sin él se muestra un aviso y coordenadas manuales
REALTYHUB_MAPBOX_TOKEN=
